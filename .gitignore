# ---- 本地数据（隐私，绝不入库）----
# 用白名单而不是逐条列扩展名：data/ 下会不断出现新的导出格式
# （.nc / .svg / .gcode / …），逐条列举必然漏掉，而漏掉的后果是
# 用户笔迹数据被提交进公开仓库。
data/*
!data/README.md
!data/.gitkeep

# ---- 模型权重与训练产物 ----
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pb
checkpoints/
runs/
wandb/
outputs/
lightning_logs/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- C++ / CMake / Qt ----
build/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.pro.user
*.pro.user.*
*.qmlc
*.jsc
.qmake.stash

# ---- IDE / 编辑器 ----
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- 字形数据缓存（派生自 Arphic PL 字体，不随仓库分发）----
.cache/
**/glyphs/

# ---- 运行时临时文件 ----
*.log
logs/
tmp/
temp/
