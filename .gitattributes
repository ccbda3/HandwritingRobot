# 统一换行符：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# Windows 专用脚本必须保持 CRLF，否则 cmd/PowerShell 会出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 显式声明文本文件（便于 diff 与语言统计）
*.py     text diff=python
*.pyi    text diff=python
*.c      text diff=cpp
*.cc     text diff=cpp
*.cpp    text diff=cpp
*.h      text diff=cpp
*.hpp    text diff=cpp
*.json   text
*.yml    text
*.yaml   text
*.toml   text
*.md     text diff=markdown
*.txt    text
*.cmake  text
CMakeLists.txt text

# 二进制文件禁止做行尾转换与文本 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.7z     binary
*.gz     binary
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.pt     binary
*.pth    binary
*.ckpt   binary
*.onnx   binary
*.safetensors binary
*.npz    binary
*.npy    binary

# 让 GitHub 语言统计忽略生成物与前端资源
capture/index.html linguist-documentation
docs/** linguist-documentation
